# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USER=recall
DB_PASSWORD=password
DB_NAME=recall_dev
DB_SSL_MODE=disable

# Test Database Configuration
DB_TEST_HOST=postgres-test
DB_TEST_PORT=5432
DB_TEST_NAME=recall_test

# S3/Storage Configuration (MinIO for dev, S3 for production)
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_SSL=false
S3_BUCKET=recall-storage
S3_REGION=us-east-1

# Test Storage Configuration
S3_TEST_ENDPOINT=minio-test:9000
S3_TEST_BUCKET=recall-test-storage

# Server Configuration
PORT=8080
ENV=development

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Supabase Configuration (for production)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sentry Configuration (for production)
SENTRY_DSN=